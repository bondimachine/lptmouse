     4                              <1> %include "bits.inc"
     1                              <2> ; bits.inc - register / pointer helpers for 16 and 32-bit builds.
     2                              <2> %ifndef BITS_INC
     3                              <2> %define BITS_INC
     4                              <2> 
     5                              <2> ; Bit width: the same source assembles as 16-bit (DOS, Windows driver) or
     6                              <2> ; 32-bit flat (the VxD). Pointer registers and the LOOP counter differ.
     7                              <2> %if __BITS__ == 32
     8                              <2>   %define RSI esi
     9                              <2>   %define RDI edi
    10                              <2>   %define PTR_T dd
    11                              <2>   PTR_SIZE equ 4
    12                              <2>   %macro SETCNT 1                   ; LOOP counter = 16-bit value %1
    13                              <2>         xor ecx, ecx
    14                              <2>         mov cx, %1
    15                              <2>   %endmacro
    16                              <2> %else
    17                              <2>   %define RSI si
    18                              <2>   %define RDI di
    19                              <2>   %define PTR_T dw
    20                              <2>   PTR_SIZE equ 2
    21                              <2>   %macro SETCNT 1
    22                              <2>         mov cx, %1
    23                              <2>   %endmacro
    24                              <2> %endif
    25                              <2> 
    26                              <2> %endif
