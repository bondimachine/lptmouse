   234 000003D3 E83CFF              <1>         call ps2_send
   235 000003D6 58                  <1>         pop ax
   236 000003D7 7217                <1>         jc .next
   237 000003D9 50                  <1>         push ax
   238 000003DA 8B16[0F00]          <1>         mov dx, [port_status]
   239                              <1>         SETCNT [t_resp]
    22 000003DE 8B0E[FC03]          <2>  mov cx, %1
   240 000003E2 E8DCFF              <1>         call ps2_recv_hold
   241 000003E5 7208                <1>         jc .rfail
   242 000003E7 3CFE                <1>         cmp al, 0FEh
   243 000003E9 7404                <1>         je .rfail
   244 000003EB 5A                  <1>         pop dx                      ; drop the saved command byte
   245 000003EC 5E                  <1>         pop si
   246 000003ED F8                  <1>         clc
   247 000003EE C3                  <1>         ret
   248                              <1> .rfail:
   249 000003EF 58                  <1>         pop ax
   250                              <1> .next:
