   186 0000132F 7501                <1>         jnz .rpm
   187 00001331 40                  <1>         inc ax
   188 00001332 A3[0404]            <1> .rpm:   mov [reads_per_ms], ax
   189 00001335 BE[0604]            <1>         mov RSI, calib_table
   190 00001338 8B3C                <1> .l:     mov RDI, [RSI]
   191 0000133A 09FF                <1>         or RDI, RDI
   192 0000133C 7424                <1>         jz .done
   193 0000133E 8B4402              <1>         mov ax, [RSI + PTR_SIZE]
   194 00001341 F726[0404]          <1>         mul word [reads_per_ms]
   195 00001345 BBE803              <1>         mov bx, 1000
   196 00001348 39DA                <1>         cmp dx, bx
   197 0000134A 730C                <1>         jae .max
   198 0000134C F7F3                <1>         div bx
   199 0000134E 83F80A              <1>         cmp ax, 10
   200 00001351 7308                <1>         jae .st
   201 00001353 B80A00              <1>         mov ax, 10
   202 00001356 EB03                <1>         jmp .st
   203 00001358 B8FFFF              <1> .max:   mov ax, 0FFFFh
   204 0000135B 8905                <1> .st:    mov [RDI], ax
   205 0000135D 83C604              <1>         add RSI, CALIB_STEP
   206 00001360 EBD6                <1>         jmp .l
