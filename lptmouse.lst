    65 00001256 723A                <1>         jc .f2
    66 00001258 E8B8FF              <1>         call trace_byte
    67                              <1> 
    68 0000125B B0F3                <1>         mov al, 0F3h                ; set sample rate
    69 0000125D E86EF1              <1>         call ps2_cmd
