   174                                  %include "ps2lpt.inc"
     1                              <1> ; ps2lpt.inc - PS/2 device protocol bit-banged on a PC parallel port.
     2                              <1> ;
     3                              <1> ; Wiring (see README.md):
     4                              <1> ;   D0  (pin 2)  -> drives PS/2 CLK low  (Schottky diode, cathode at the port)
     5                              <1> ;   D1  (pin 3)  -> drives PS/2 DATA low (Schottky diode, cathode at the port)
     6                              <1> ;   /ACK (pin 10) <- PS/2 CLK   (status bit 6, also raises the port IRQ)
     7                              <1> ;   SELECT (pin 13) <- PS/2 DATA (status bit 4)
     8                              <1> ;
     9                              <1> ; Writing 0 to D0/D1 pulls the line low, 1 releases it (open-collector
    10                              <1> ; emulation). With an inverting driver (2N7000 / 74LS05) set drive_xor = 03h.
    11                              <1> ;
    12                              <1> ; The includer defines (in the segment DS points to):
    13                              <1> ;   port_data   dw  base port (378h...)
    14                              <1> ;   port_status dw  base + 1
    15                              <1> ;   drive_xor   db  0 (diodes / 74HC07) or 03h (inverting driver)
    16                              <1> ;
    17                              <1> ; Timeouts are counted in status port reads (polling loop iterations) and
    18                              <1> ; calibrated at startup, see calibrate_timeouts in ps2init.inc. The PS/2 clock runs at 10-16.7 kHz (30-50 us half period).
    19                              <1> ;
    20                              <1> ; All routines must run with interrupts disabled (except mouse init waits).
    21                              <1> ; 8086 instructions only.
    22                              <1> 
    23                              <1> STAT_CLK    equ 40h     ; status bit 6: /ACK, pin 10
    24                              <1> STAT_DATA   equ 10h     ; status bit 4: SELECT, pin 13
    25                              <1> 
    26                              <1> OUT_IDLE    equ 0FFh    ; CLK and DATA released
    27                              <1> OUT_CLKLO   equ 0FEh    ; CLK held low (inhibit), DATA released
    28                              <1> OUT_DATLO   equ 0FDh    ; DATA low, CLK released
    29                              <1> OUT_BOTHLO  equ 0FCh
    30                              <1> 
    31                              <1> ; Timeouts are variables (t_xxx, in port reads) set by calibrate_timeouts
    32                              <1> ; from the measured port speed; the defaults assume 1 read per microsecond.
    33                              <1> 
    34                              <1> %include "bits.inc"
     1                              <2> ; bits.inc - register / pointer helpers for 16 and 32-bit builds.
     2                              <2> %ifndef BITS_INC
     3                              <2> %define BITS_INC
     4                              <2> 
     5                              <2> ; Bit width: the same source assembles as 16-bit (DOS, Windows driver) or
     6                              <2> ; 32-bit flat (the VxD). Pointer registers and the LOOP counter differ.
     7                              <2> %if __BITS__ == 32
     8                              <2>   %define RSI esi
     9                              <2>   %define RDI edi
    10                              <2>   %define PTR_T dd
    11                              <2>   PTR_SIZE equ 4
    12                              <2>   %macro SETCNT 1                   ; LOOP counter = 16-bit value %1
    13                              <2>         xor ecx, ecx
    14                              <2>         mov cx, %1
    15                              <2>   %endmacro
    16                              <2> %else
    17                              <2>   %define RSI si
    18                              <2>   %define RDI di
    19                              <2>   %define PTR_T dw
    20                              <2>   PTR_SIZE equ 2
    21                              <2>   %macro SETCNT 1
    22                              <2>         mov cx, %1
    23                              <2>   %endmacro
    24                              <2> %endif
    25                              <2> 
    26                              <2> %endif
    35                              <1> 
    36                              <1> ; wait until (status & %1) == 0, at most %2 reads, else jump to %3.
    37                              <1> ; DX = status port. Clobbers AL, CX. AL holds the last status read.
    38                              <1> %macro WAITLO 3
    39                              <1>         SETCNT %2
    40                              <1> %%l:    in al, dx
    41                              <1>         test al, %1
    42                              <1>         jz %%ok
    43                              <1>         loop %%l
    44                              <1>         jmp %3
    45                              <1> %%ok:
    46                              <1> %endmacro
    47                              <1> 
    48                              <1> ; wait until (status & %1) != 0
    49                              <1> %macro WAITHI 3
    50                              <1>         SETCNT %2
    51                              <1> %%l:    in al, dx
    52                              <1>         test al, %1
    53                              <1>         jnz %%ok
    54                              <1>         loop %%l
    55                              <1>         jmp %3
    56                              <1> %%ok:
    57                              <1> %endmacro
    58                              <1> 
    59                              <1> ; burn %1 port reads (DX = any readable port). Clobbers AL, CX.
    60                              <1> %macro DELAY 1
    61                              <1>         SETCNT %1
    62                              <1> %%l:    in al, dx
    63                              <1>         loop %%l
    64                              <1> %endmacro
    65                              <1> 
    66                              <1> ; set the CLK/DATA drive bits: AL = OUT_xxx. DX = data port.
    67                              <1> %macro LINES 1
    68                              <1>         mov al, %1
    69                              <1>         xor al, [drive_xor]
    70                              <1>         out dx, al
    71                              <1> %endmacro
    72                              <1> 
    73                              <1> ; ---------------------------------------------------------------------------
    74                              <1> ; ps2_lines: AL = OUT_xxx value, written to the data port. Keeps DX.
    75                              <1> ; ---------------------------------------------------------------------------
    76                              <1> ps2_lines:
    77 00000264 52                  <1>         push dx
    78 00000265 8B16[0D00]          <1>         mov dx, [port_data]
    79 00000269 3206[1300]          <1>         xor al, [drive_xor]
    80 0000026D EE                  <1>         out dx, al
    81 0000026E 5A                  <1>         pop dx
    82 0000026F C3                  <1>         ret
    83                              <1> 
    84                              <1> ; ---------------------------------------------------------------------------
    85                              <1> ; ps2_recv: receive one byte from the device.
    86                              <1> ;   in:  DX = status port, CX (ECX) = reads to wait for the start bit,
    87                              <1> ;        CLK released
    88                              <1> ;   out: CF=0, AL = byte
    89                              <1> ;        CF=1, AH = 1 no start bit, 2 framing/timeout, 3 parity error
    90                              <1> ;   Clobbers CX, AL/AH.
    91                              <1> ; ---------------------------------------------------------------------------
    92                              <1> ps2_recv:
    93 00000270 53                  <1>         push bx
    94 00000271 EC                  <1> .ws:    in al, dx
    95 00000272 A840                <1>         test al, STAT_CLK
    96 00000274 7407                <1>         jz .start
    97 00000276 E2F9                <1>         loop .ws
    98 00000278 B401                <1>         mov ah, 1
    99 0000027A E99200              <1>         jmp .fail
   100                              <1> .start:
   101 0000027D A810                <1>         test al, STAT_DATA          ; start bit must be 0
   102 0000027F 7403E98500          <1>         jnz .frame
   103                              <1>         WAITHI STAT_CLK, [t_bit], .frame
    50                              <2>  SETCNT %2
    22 00000284 8B0E[F603]          <3>  mov cx, %1
    51 00000288 EC                  <2> %%l: in al, dx
    52 00000289 A840                <2>  test al, %1
    53 0000028B 7504                <2>  jnz %%ok
    54 0000028D E2F9                <2>  loop %%l
    55 0000028F EB78                <2>  jmp %3
    56                              <2> %%ok:
   104 00000291 31DB                <1>         xor bx, bx                  ; BL = byte, BH = count of ones
   105 00000293 B408                <1>         mov ah, 8
   106                              <1> .bit:
   107                              <1>         WAITLO STAT_CLK, [t_bit], .frame
    39                              <2>  SETCNT %2
    22 00000295 8B0E[F603]          <3>  mov cx, %1
    40 00000299 EC                  <2> %%l: in al, dx
    41 0000029A A840                <2>  test al, %1
    42 0000029C 7404                <2>  jz %%ok
    43 0000029E E2F9                <2>  loop %%l
    44 000002A0 EB67                <2>  jmp %3
    45                              <2> %%ok:
   108 000002A2 D0EB                <1>         shr bl, 1                   ; LSB first
   109 000002A4 A810                <1>         test al, STAT_DATA          ; data is valid while CLK is low
   110 000002A6 7405                <1>         jz .zero
   111 000002A8 80CB80              <1>         or bl, 80h
   112 000002AB FEC7                <1>         inc bh
   113                              <1> .zero:
   114                              <1>         WAITHI STAT_CLK, [t_bit], .frame
    50                              <2>  SETCNT %2
    22 000002AD 8B0E[F603]          <3>  mov cx, %1
    51 000002B1 EC                  <2> %%l: in al, dx
    52 000002B2 A840                <2>  test al, %1
    53 000002B4 7504                <2>  jnz %%ok
    54 000002B6 E2F9                <2>  loop %%l
    55 000002B8 EB4F                <2>  jmp %3
