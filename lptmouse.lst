    65 0000124E 723A                <1>         jc .f2
    66 00001250 E8B8FF              <1>         call trace_byte
    67                              <1> 
    68 00001253 B0F3                <1>         mov al, 0F3h                ; set sample rate
    69 00001255 E876F1              <1>         call ps2_cmd
    70 00001258 7234                <1>         jc .f3
    71 0000125A E8AEFF              <1>         call trace_byte
    72 0000125D 3CFA                <1>         cmp al, 0FAh
    73 0000125F 752D                <1>         jne .f3
    74 00001261 A0[1700]            <1>         mov al, [sample_rate]
    75 00001264 E867F1              <1>         call ps2_cmd
    76 00001267 7225                <1>         jc .f3
