     6                              <1> ; ---------------------------------------------------------------------------
     7                              <1> ; Timeouts in polling loop iterations (see calibrate_timeouts)
     8                              <1> ; ---------------------------------------------------------------------------
     9 000003F6 2C01                <1> t_bit       dw 300      ; edge inside a byte (half clock period <= 50 us)
    10 000003F8 B80B                <1> t_start     dw 3000     ; first clock of a byte after releasing CLK
    11 000003FA D007                <1> t_gap       dw 2000     ; next byte of the same packet
    12 000003FC A861                <1> t_resp      dw 25000    ; reply to a command (device: up to 20 ms)
    13 000003FE 204E                <1> t_txstart   dw 20000    ; device starts clocking a host byte (up to 15 ms)
    14 00000400 1027                <1> t_resend    dw 10000    ; packet after a resend request
    15 00000402 C800                <1> d_inhibit   dw 200      ; CLK held low before a send / to abort (>= 100 us)
    16 00000404 E803                <1> reads_per_ms dw 1000
