   108                              <1> ; ---------------------------------------------------------------------------
   109                              <1> ; line_test: check the cable without talking to the mouse.
   110                              <1> ;   out: CF=0 ok; CF=1, AL = 1 CLK stuck low, 2 DATA stuck low,
   111                              <1> ;        3 D0 cannot pull CLK low, 4 D1 cannot pull DATA low,
   112                              <1> ;        5 CLK and DATA move together
