   216 000003C8 E899FE              <1>         call ps2_lines
   217 000003CB 9D                  <1>         popf
   218 000003CC 58                  <1>         pop ax
   219 000003CD C3                  <1>         ret
   220                              <1> 
   221                              <1> ; ---------------------------------------------------------------------------
   222                              <1> ; ps2_cmd: send a command byte and read the device's reply (FA = ack).
   223                              <1> ; Retries 3 times on a send failure or an FE (resend) reply. Leaves CLK
   224                              <1> ; inhibited.
   225                              <1> ;   in:  AL = byte
   226                              <1> ;   out: CF=0, AL = reply; CF=1 no reply
   227                              <1> ;   Clobbers AX, CX, DX.
   228                              <1> ; ---------------------------------------------------------------------------
