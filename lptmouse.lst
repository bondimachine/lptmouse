     1                              <1> ; burst.inc - read one packet burst from the mouse (16 or 32-bit).
     2                              <1> ; Needs ps2lpt.inc. The includer defines:
     3                              <1> ;   burst_buf (BURST_MAX bytes), nbytes (dw), cnt_errors (dw), cnt_resend (dw),
     4                              <1> ;   resend_empty (byte: nonzero when an interrupt means a packet was sent)
     5                              <1> ; Must run with interrupts disabled.
     6                              <1> 
