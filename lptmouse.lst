   146                              <1> ; ---------------------------------------------------------------------------
   147                              <1> ; ps2_send: send one byte to the device (host-to-device frame, waits for the
   148                              <1> ; device's ack bit, not for its FA reply).
   149                              <1> ;   in:  AL = byte
   150                              <1> ;   out: CF=0 ok, CF=1 failed (lines released)
   151                              <1> ;   Clobbers AX, CX, DX.
   152                              <1> ; ---------------------------------------------------------------------------
   153                              <1> ps2_send:
   154 00000312 53                  <1>         push bx
   155 00000313 88C3                <1>         mov bl, al
   156 00000315 B702                <1>         mov bh, 2                   ; bit 9 (BH bit 1) = stop bit = 1
   157 00000317 84C0                <1>         test al, al                 ; PF=1 when the number of ones is even
   158 00000319 7B03                <1>         jpo .odd
   159 0000031B 80CF01              <1>         or bh, 1                    ; bit 8 = parity, makes the total odd
   160                              <1> .odd:
   161 0000031E 8B16[0D00]          <1>         mov dx, [port_data]
   162                              <1>         LINES OUT_CLKLO             ; request to send: CLK low >= 100 us
    68 00000322 B0FE                <2>  mov al, %1
    69 00000324 3206[1300]          <2>  xor al, [drive_xor]
    70 00000328 EE                  <2>  out dx, al
   163 00000329 42                  <1>         inc dx
   164                              <1>         DELAY [d_inhibit]
    61                              <2>  SETCNT %1
    22 0000032A 8B0E[0204]          <3>  mov cx, %1
    62 0000032E EC                  <2> %%l: in al, dx
    63 0000032F E2FD                <2>  loop %%l
   165 00000331 4A                  <1>         dec dx
   166                              <1>         LINES OUT_BOTHLO            ; DATA low = start bit
    68 00000332 B0FC                <2>  mov al, %1
    69 00000334 3206[1300]          <2>  xor al, [drive_xor]
    70 00000338 EE                  <2>  out dx, al
   167                              <1>         LINES OUT_DATLO             ; release CLK, the device clocks now
    68 00000339 B0FD                <2>  mov al, %1
    69 0000033B 3206[1300]          <2>  xor al, [drive_xor]
    70 0000033F EE                  <2>  out dx, al
   168 00000340 42                  <1>         inc dx
   169                              <1>         WAITLO STAT_CLK, [t_txstart], .fail
    39                              <2>  SETCNT %2
    22 00000341 8B0E[FE03]          <3>  mov cx, %1
    40 00000345 EC                  <2> %%l: in al, dx
    41 00000346 A840                <2>  test al, %1
    42 00000348 7404                <2>  jz %%ok
    43 0000034A E2F9                <2>  loop %%l
    44 0000034C EB6B                <2>  jmp %3
