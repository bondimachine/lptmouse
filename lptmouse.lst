   115 000002BA FECC                <1>         dec ah
   116 000002BC 75D7                <1>         jnz .bit
   117                              <1>         ; parity bit
   118                              <1>         WAITLO STAT_CLK, [t_bit], .frame
    39                              <2>  SETCNT %2
    22 000002BE 8B0E[F603]          <3>  mov cx, %1
    40 000002C2 EC                  <2> %%l: in al, dx
    41 000002C3 A840                <2>  test al, %1
    42 000002C5 7404                <2>  jz %%ok
    43 000002C7 E2F9                <2>  loop %%l
